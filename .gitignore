# ==========================================================
# KotoDojo - .gitignore
# Lo que se publica es index.html junto con css/, js/ y data/.
# ==========================================================

# Copia de trabajo antigua de un solo archivo (ya no se usa: la app está en index.html + css/ + js/ + data/)
juego japones.html

# Dependencias de desarrollo (Tailwind CLI). css/tailwind.css SÍ se versiona.
node_modules/

# Configuración local de Claude Code (worktrees, servidores de vista previa)
.claude/

# Material de estudio (PDFs, imágenes, libros, artículos) - pesado y con derechos de autor
material/
*.pdf
*.docx
*.jpeg
*.jpg
*.png

# Backups, duplicados y archivos comprimidos
_archivo/
*.bak
*.bak_*
*.zip

# Herramientas y proyectos de referencia externos
herramientas/
*.vsix
referencias/
hiragana-master/

# Scripts de parches de un solo uso y sus salidas
scratch/

# Configuración local del editor y del sistema
.vscode/
Thumbs.db
desktop.ini
.DS_Store
