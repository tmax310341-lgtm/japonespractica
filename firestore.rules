rules_version = '2';

// KotoDojo · Reglas de seguridad de Firestore
// Cada usuario solo puede leer y escribir su propio documento users/{uid}.
// Copia este archivo en: Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progressJson', 'savedAt', 'updatedAt', 'schema'])
        && request.resource.data.progressJson is string
        && request.resource.data.progressJson.size() < 900000;
    }
  }
}
